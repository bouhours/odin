<Files "common.php">
    <IfModule mod_authz_core.c>
        # Apache 2.4+
        Require all denied
    </IfModule>

    <IfModule !mod_authz_core.c>
        # Apache 2.2
        Order Allow,Deny
        Deny from All
    </IfModule>
</Files>

